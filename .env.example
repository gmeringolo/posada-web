# Copiá este archivo como .env.local para probar en tu compu.
# En Netlify, cargá las mismas variables en Site configuration → Environment variables.

# Google Analytics 4 (ID de medición, empieza con G-). Vacío = no se carga Analytics.
NEXT_PUBLIC_GA_ID=

# Supabase (app Posada reservas). Opcionales: si no están, se usan los de data/site.ts.
# Usar SIEMPRE la clave pública "anon", nunca la service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
